# Sample nginx config for matrix-appservice-nostr.
#
# Two things need to reach the bridge (127.0.0.1:8092 here; bridge.listen_host
# and bridge.listen_port in config.yaml):
#
#   1. /.well-known/nostr.json on bridge.domain (example.org), for NIP-05
#      handles. Add the location block below to the server block that already
#      serves that domain (often the same one serving Matrix's own
#      /.well-known files). It must PROXY, not redirect: NIP-05 forbids
#      redirects and clients ignore them.
#
#   2. The relay hostname (nostr.relay_url, here wss://nostr.example.org).
#      A server block of its own, below. Everything on it goes to the bridge:
#        GET  /  with a WebSocket upgrade   the relay (NIP-01, NIP-42)
#        GET  /  Accept: application/nostr+json   its NIP-11 document
#        POST /                             NIP-86 relay management
#        GET/HEAD /<sha256>.<ext>           published media (Blossom BUD-01)
#        PUT  /upload                       uploads from users' Nostr apps (BUD-02)
#        /widget, /widget/api/...           the bridge's room widget
#      So don't restrict methods, and let request bodies through up to
#      nostr.max_media_mb.
#
# CORS: the bridge sets Access-Control-Allow-Origin itself, on /.well-known/
# and on the relay host's public paths, and answers OPTIONS preflights. Don't
# add_header one of your own (browsers reject a doubled header), and don't
# answer OPTIONS in nginx.

upstream matrix_appservice_nostr {
    server 127.0.0.1:8092;
}

# -- 1. In the existing server block for example.org ---------------------
#
#    location = /.well-known/nostr.json {
#        proxy_pass http://matrix_appservice_nostr;
#        proxy_set_header Host $host;
#        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#        proxy_set_header X-Forwarded-Proto $scheme;
#    }

# -- 2. The relay hostname ------------------------------------------------

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name nostr.example.org;  # <-- the host in nostr.relay_url

    ssl_certificate     /etc/letsencrypt/live/nostr.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/nostr.example.org/privkey.pem;

    # The AppService API is for the homeserver only, which reaches the bridge
    # directly (bridge.internal_base_url). Nothing public needs it.
    location /_matrix/ {
        return 404;
    }

    location / {
        proxy_pass http://matrix_appservice_nostr;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        # The relay's rate limits and bans are per client IP, read from here.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Relay connections stay open; don't cut idle ones after 60s.
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        # Blossom uploads (PUT /upload) can be as large as nostr.max_media_mb
        # (50 by default). Keep this at least that big.
        client_max_body_size 50m;
    }
}

# Games (webxdc.enabled): the sandbox games run in. Its own hostname
# (webxdc.sandbox_domain), passed to the bridge with its Host header; the
# bridge serves only the game loader and its service worker there.
server {
    listen 443 ssl http2;
    server_name xdc.example.org;  # <-- webxdc.sandbox_domain
    ssl_certificate     /etc/letsencrypt/live/example.org-wildcard/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.org-wildcard/privkey.pem;

    location / {
        proxy_pass http://matrix_appservice_nostr;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
